# Copy to .env and fill values locally. DO NOT commit your real keys.

# AI provider.
# OpenAI padrao:
OPENAI_API_KEY=
USE_OPENAI_FOR_POSTS=true
OPENAI_MODEL=gpt-4o-mini

# DeepSeek opcional:
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# Server port override
PORT=3008

# Number of posts to generate in pipeline
POSTS_PER_RUN=10
APIFY_TOKEN=cole_sua_chave_da_apify_aqui
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
OPENAI_API_KEY=cole_sua_chave_da_openai_aqui
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_FOR_POSTS=false
BRAVE_SEARCH_API_KEY=cole_sua_chave_brave_aqui
GOOGLE_CUSTOM_SEARCH_API_KEY=cole_sua_chave_google_aqui
GOOGLE_CUSTOM_SEARCH_CX=cole_o_id_do_programmable_search_engine_aqui

PORT=3007
CRON_SCHEDULE=0 * * * *
MAX_ITEMS=40
POSTS_PER_RUN=10
MIN_INTERNATIONAL_SCORE=120
MAX_INTERNATIONAL_CANDIDATES=3

# Optional strict mode: when true, rejects non-placeholder web images unless
# their credit was extracted from the image source page or came from Instagram/manual/official metadata.
REQUIRE_PAGE_IMAGE_CREDIT=false

WP_URL=https://seusite.com.br
WP_USER=seu_usuario
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_STATUS=draft
