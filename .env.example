# Copy to .env and fill values locally. Never commit real keys.

# Text generation provider. OpenAI-compatible endpoints are supported.
# OpenAI default:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_CODEX_FOR_POSTS=false
CODEX_HOME=
CODEX_BIN=
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=high
CODEX_POSTS_TIMEOUT_MS=180000

# Optional independent factual and visual review models.
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Uses the locally authenticated Codex CLI only when explicitly enabled.
USE_CODEX_VISION=false
CODEX_VISION_TIMEOUT_MS=180000

# Optional DeepSeek writer:
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat

USE_OPENAI_FOR_POSTS=true

# Editorial queue.
MAX_ITEMS=40
MAX_CAIQUE_NEWS_POOL=40
POSTS_PER_RUN=10
MIN_REVIEW_DRAFTS=5
MAX_EDITORIAL_ATTEMPTS=30
MIN_CANDIDATES_PER_CATEGORY=5
MAX_TREND_SEARCHES=5
MIN_CANDIDATE_SCORE=45
MAX_PUBLISHED_ARTICLES=100
MIN_INTERNATIONAL_SCORE=120
MAX_INTERNATIONAL_CANDIDATES=3

# Image sources. Without APIFY_TOKEN, the pipeline uses visually reviewed
# web candidates and leaves uncertain images pending for human review.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
REQUIRE_PAGE_IMAGE_CREDIT=false

# Server and schedule.
PORT=3007
CRON_SCHEDULE=0 * * * *

# WordPress publishing remains explicit and only reads approved articles.
WP_URL=https://seusite.com.br
WP_USER=seu_usuario
WP_APP_PASSWORD=
WP_STATUS=draft
